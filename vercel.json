{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "frontend/**",
      "excludeFiles": "{tests/**,evals/**,docs/**,scripts/**,data/datasets/**,data/employee_resumes/**,uploads/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
